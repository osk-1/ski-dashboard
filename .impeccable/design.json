  "components": [
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-button",
      "description": "24 h / 72 h / 7 d switch; selected segment fills with the accent.",
      "html": "<div class=\"ds-seg\"><button>24h</button><button aria-pressed=\"true\">72h</button><button>7d</button></div>",
      "css": ".ds-seg{display:flex;max-width:420px;border:1px solid #d8e0e8;border-radius:8px;overflow:hidden;font-family:Barlow,system-ui,sans-serif}.ds-seg button{flex:1;min-height:34px;padding:0 12px;font:600 .85rem/1 Barlow,system-ui,sans-serif;color:#5b6b7d;background:#f4f7fa;border:0;border-left:1px solid #d8e0e8;cursor:pointer}.ds-seg button:first-child{border-left:0}.ds-seg button[aria-pressed=true]{color:#fff;background:#1d5fc4}.ds-seg button:focus-visible{outline:2px solid #1d5fc4;outline-offset:-2px}"
    },
    {
