      "description": "Flat white panel with a hairline border and uppercase condensed title.",
      "html": "<section class=\"ds-panel\"><h2>Snow height</h2><p>Updated 20 Nov, 16:35 \u00b7 29 stations</p></section>",
      "css": ".ds-panel{background:#fff;color:#142030;border:1px solid #d8e0e8;border-radius:10px;padding:16px;font:15px/1.5 Barlow,system-ui,sans-serif}.ds-panel h2{font:600 1.15rem/1.2 'Barlow Condensed',Arial Narrow,sans-serif;letter-spacing:.02em;text-transform:uppercase;margin:0 0 10px}.ds-panel p{margin:0;color:#5b6b7d;font-size:.85rem}"
    },
