  "narrative": {
    "northStar": "The Quiet Barometer",
    "overview": "The interface is an instrument you glance at, not a site you browse. A cool blue-grey field, one blue accent, and condensed Barlow numerals let the map and the readings carry everything. Chrome recedes: panels are paper-white on a pale sky ground, separated by hairlines, with no decoration that is not data.",
    "keyCharacteristics": [
      "Flat, tonal, hairline-bordered surfaces; one lifted layer (the phone sheet).",
      "One accent (barometer blue) used for selection, focus and links, never for decoration.",
      "Condensed display face for headings and big numbers; humanist sans for everything else.",
      "Snow depth is a five-step blue ramp; wind is a single ember orange; avalanche danger uses the fixed EAWS colours.",
      "Every reading carries its age, source or trust state."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Barometer Blue marks what is selected or interactive. It is never used for decoration, and a second accent hue is not added.",
        "section": "colors"
      },
      {
        "name": "The Measured-First Rule",
        "body": "Measured series are solid; model series are dashed and labelled with their source. Suspect values fade and carry a reason; they are never recoloured to alarm.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numerals Rule",
        "body": "Anything numeric that may change or align in a column uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Small-Print Age Rule",
        "body": "Timestamps, sources and trust notes are 0.72 to 0.8rem muted text next to the value, never a separate block.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces stay flat at rest. A shadow appears only where a layer genuinely floats above the map.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep surfaces flat with 1px Hairline borders; use Barometer Tint for selection.",
      "Do show age, source or trust beside every reading in 0.72 to 0.8rem muted text.",
      "Do use tabular figures for all aligned numbers and Barlow Condensed for large readings.",
      "Do keep touch targets at 44px on phones and a visible 2px accent focus outline.",
      "Do keep model data dashed and labelled with its source; keep the snow ramp inverted in dark mode."
    ],
    "donts": [
      "Don't add card shadows, gradients, glass or decorative imagery; depth is tonal.",
      "Don't introduce a second accent colour or use blue for non-interactive decoration.",
      "Don't theme or restyle the EAWS danger colours.",
      "Don't hide or recolour suspect data to alarm; fade it and give the reason."
    ]
  }
}